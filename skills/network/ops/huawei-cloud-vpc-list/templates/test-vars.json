{
  "test_cases": [
    {
      "id": "TC-01",
      "name": "List VPCs (v3, limited)",
      "command": "hcloud VPC ListVpcs/v3 --cli-region=cn-north-4 --limit=3 --cli-output=json",
      "expected": "JSON with vpcs array; exit 0"
    },
    {
      "id": "TC-02",
      "name": "List VPCs (v2 legacy)",
      "command": "hcloud VPC ListVpcs/v2 --cli-region=cn-north-4 --limit=3 --cli-output=json",
      "expected": "JSON with vpcs array; exit 0"
    },
    {
      "id": "TC-03",
      "name": "Filter by name (v3)",
      "command": "hcloud VPC ListVpcs/v3 --cli-region=cn-north-4 --name.1=tf-web-vpc --cli-output=json",
      "expected": "JSON with vpcs array (filtered); exit 0"
    },
    {
      "id": "TC-04",
      "name": "Filter by enterprise project (all_granted_eps)",
      "command": "hcloud VPC ListVpcs/v3 --cli-region=cn-north-4 --enterprise_project_id=all_granted_eps --limit=3 --cli-output=json",
      "expected": "JSON with vpcs array; exit 0"
    },
    {
      "id": "TC-05",
      "name": "Max page size (limit=2000)",
      "command": "hcloud VPC ListVpcs/v3 --cli-region=cn-north-4 --limit=2000 --cli-output=json",
      "expected": "JSON with vpcs array; exit 0"
    },
    {
      "id": "TC-06",
      "name": "Accurate total via marker pagination",
      "command": "marker loop until page_info.next_marker is absent, sum vpcs across pages",
      "expected": "Total count equals sum of all pages; current_count alone is not the total"
    },
    {
      "id": "TC-07",
      "name": "SDK import check (fallback)",
      "command": "python3 -c \"from huaweicloudsdkvpc.v3 import ListVpcsRequest\"",
      "expected": "Import succeeds; exit 0"
    }
  ]
}
