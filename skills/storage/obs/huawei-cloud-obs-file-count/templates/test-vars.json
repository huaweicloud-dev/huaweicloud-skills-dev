{
  "skill_name": "huawei-cloud-obs-file-count",
  "region": "cn-north-4",
  "test_cases": [
    {
      "id": "TC-01",
      "name": "Whole-bucket file count (CLI auto)",
      "command": "python3 scripts/count_obs_files.py --bucket obs-hd-dev-static",
      "expected": "Single integer = total files in bucket, matching 'File number' from hcloud OBS ls -limit=0",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-02",
      "name": "File count under prefix (CLI auto)",
      "command": "python3 scripts/count_obs_files.py --bucket obs-hd-dev-static --prefix openplatform",
      "expected": "Single integer = files under openplatform/ (verified 1086)",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-03",
      "name": "File count under prefix with trailing slash",
      "command": "python3 scripts/count_obs_files.py --bucket obs-hd-dev-static --prefix openplatform/",
      "expected": "Same integer as TC-02 (prefix normalization)",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-04",
      "name": "File count under prefix (SDK)",
      "command": "python3 scripts/count_obs_files.py --bucket obs-hd-dev-static --prefix openplatform --executor sdk",
      "expected": "Same integer as TC-02 (CLI/SDK cross-check)",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-05",
      "name": "Empty prefix returns 0",
      "command": "python3 scripts/count_obs_files.py --bucket obs-hd-dev-static --prefix nonexistent-prefix-xyz",
      "expected": "0",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-06",
      "name": "Nonexistent bucket error (auto)",
      "command": "python3 scripts/count_obs_files.py --bucket no-such-bucket-xyz",
      "expected": "exit 1, stderr contains Chinese NoSuchBucket hint, stdout empty",
      "type": "negative",
      "executor": "script"
    },
    {
      "id": "TC-07",
      "name": "Nonexistent bucket error (SDK)",
      "command": "python3 scripts/count_obs_files.py --bucket no-such-bucket-xyz --executor sdk",
      "expected": "exit 1, stderr contains Chinese NoSuchBucket hint, stdout empty",
      "type": "negative",
      "executor": "script"
    },
    {
      "id": "TC-08",
      "name": "SDK availability check",
      "command": "python3 -c \"from huaweicloudsdkobs.v1.obs_client import ObsClient; print('SDK OK')\"",
      "expected": "SDK import succeeds",
      "type": "syntax",
      "executor": "sdk"
    }
  ],
  "env_vars_required": ["HUAWEI_ACCESS_KEY", "HUAWEI_SECRET_KEY"],
  "notes": "只读操作，无资源创建/修改/删除风险。测试 bucket 可通过 TEST_OBS_BUCKET 覆盖。"
}
