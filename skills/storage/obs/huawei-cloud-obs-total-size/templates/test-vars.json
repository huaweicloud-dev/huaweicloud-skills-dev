{
  "skill_name": "huawei-cloud-obs-total-size",
  "region": "cn-north-4",
  "test_cases": [
    {
      "id": "TC-01",
      "name": "Single bucket total size (CLI auto)",
      "command": "python3 scripts/query_obs_total_size.py --bucket obs-hd-dev-static",
      "expected": "Single integer = total bucket size in bytes",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-02",
      "name": "Single bucket total size (SDK)",
      "command": "python3 scripts/query_obs_total_size.py --bucket obs-hd-dev-static --executor sdk",
      "expected": "Single integer matching CLI size",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-03",
      "name": "All buckets total size (SDK)",
      "command": "python3 scripts/query_obs_total_size.py --all --executor sdk",
      "expected": "Single integer >= single bucket size",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-04",
      "name": "Unit conversion MB",
      "command": "python3 scripts/query_obs_total_size.py --all --unit mb",
      "expected": "Decimal value in MB",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-05",
      "name": "Human readable output",
      "command": "python3 scripts/query_obs_total_size.py --all --human",
      "expected": "Human readable size (e.g. 8.88GB)",
      "type": "readonly",
      "executor": "script"
    },
    {
      "id": "TC-06",
      "name": "SDK availability check",
      "command": "python3 -c \"from huaweicloudsdkobs.v1.obs_client import ObsClient; print('SDK OK')\"",
      "expected": "SDK import succeeds",
      "type": "syntax",
      "executor": "sdk"
    }
  ],
  "env_vars_required": ["HUAWEI_ACCESS_KEY", "HUAWEI_SECRET_KEY"],
  "notes": "只读操作，无资源创建/修改/删除风险。测试 bucket 可通过 TEST_OBS_BUCKET 覆盖。"
}
