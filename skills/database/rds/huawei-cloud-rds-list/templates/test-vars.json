{
  "region": "cn-north-4",
  "test_cases": [
    {
      "id": "TC-01",
      "name": "List All RDS Instances (CLI)",
      "command": "hcloud RDS ListInstances --cli-region=cn-north-4 --limit=10 --cli-output=json",
      "expected": "JSON object with instances array; each has id/name/status"
    },
    {
      "id": "TC-02",
      "name": "Extract RDS Instance Names Only (CLI)",
      "command": "hcloud RDS ListInstances --cli-region=cn-north-4 --limit=10 --cli-query=\"instances[].name\"",
      "expected": "List of RDS instance names"
    },
    {
      "id": "TC-03",
      "name": "List RDS Instances Filtered By Engine (CLI)",
      "command": "hcloud RDS ListInstances --cli-region=cn-north-4 --datastore_type=MySQL --limit=10 --cli-output=json",
      "expected": "instances array with datastore.type=MySQL"
    },
    {
      "id": "TC-04",
      "name": "List RDS Instances Filtered By Type (CLI)",
      "command": "hcloud RDS ListInstances --cli-region=cn-north-4 --type=Ha --limit=10 --cli-output=json",
      "expected": "instances array with type=Ha"
    },
    {
      "id": "TC-05",
      "name": "List RDS Instances With Pagination (CLI)",
      "command": "hcloud RDS ListInstances --cli-region=cn-north-4 --limit=5 --offset=0 --cli-output=json",
      "expected": "instances array limited to 5"
    },
    {
      "id": "TC-06",
      "name": "Quality-Reporting Wrapper (names only, reporting disabled)",
      "command": "SKILL_QUALITY_DISABLE=1 python3 scripts/list_rds_instances.py --region=cn-north-4 --names-only --limit 10",
      "expected": "One RDS instance name per line"
    },
    {
      "id": "TC-07",
      "name": "SDK Fallback (names only)",
      "command": "python3 scripts/list_rds_instances.py --region=cn-north-4 --names-only --executor sdk --limit 10",
      "expected": "Same RDS instance names as CLI"
    }
  ]
}
